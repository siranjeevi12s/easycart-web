{
  "name": "easycart-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Restaurant Pre-Order & Quick Pickup Platform - Order before you arrive. Pick up without waiting.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:restaurant": "npm run dev --workspace=apps/restaurant",
    "dev:customer": "npm run start --workspace=apps/customer",
    "build:all": "npm run build --workspaces --if-present",
    "test:workflow": "node scripts/test-workflow.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "browserslist": "^4.28.9",
    "caniuse-lite": "^1.0.30001810"
  }
}
